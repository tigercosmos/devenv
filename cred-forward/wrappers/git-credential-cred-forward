#!/bin/sh
# Git credential helper: answers "get" for github.com over HTTPS with the
# forwarded login that the account map selects for the repository owner.
# "store" and "erase" are accepted and ignored; nothing is written anywhere.
#
# When forwarding is off for gh, the same account comes from the remote's own
# gh login. A missing local login for that account is an error: the push is
# never made as whichever user happens to be logged in.
set -eu

script_path=$0
while [ -L "$script_path" ]; do
    script_dir=$(CDPATH='' cd -- "$(dirname -- "$script_path")" && pwd -P)
    link_target=$(readlink "$script_path")
    case $link_target in
        /*) script_path=$link_target ;;
        *) script_path=$script_dir/$link_target ;;
    esac
done
wrapper_dir=$(CDPATH='' cd -- "$(dirname -- "$script_path")" && pwd -P)
unset script_path script_dir link_target
# shellcheck source=wrappers/_common.sh
. "$wrapper_dir/_common.sh"

[ "${1:-}" = get ] || exit 0

protocol=
host=
path=
while IFS= read -r line; do
    [ -n "$line" ] || break
    case $line in
        protocol=*) protocol=${line#protocol=} ;;
        host=*) host=${line#host=} ;;
        path=*) path=${line#path=} ;;
    esac
done
# Leave other hosts and protocols to the next helper in git's list.
[ "$protocol" = https ] && [ "$host" = github.com ] || exit 0

account_map=${CRED_FORWARD_GITHUB_ACCOUNTS:-"$HOME/.config/cred-forward/github-accounts"}
owner=
if [ -n "$path" ]; then
    owner=$(cred_forward_github_owner "github.com/$path") || owner=
fi
if [ -n "${CRED_FORWARD_GITHUB_ACCOUNT:-}" ]; then
    account=$CRED_FORWARD_GITHUB_ACCOUNT
elif [ -f "$account_map" ]; then
    account=$(cred_forward_github_resolve_account "$account_map" "$owner") || exit 1
else
    account=
fi

# local_credential — the token of the remote's own gh login for the account.
local_credential() {
    real_gh=$(cred_forward_real gh "${CRED_FORWARD_REAL_GH:-}" "$wrapper_dir") || exit 1
    if [ -n "$account" ]; then
        credential=$("$real_gh" auth token --hostname github.com --user "$account" 2>/dev/null) || {
            echo "cred-forward: the local gh has no login for $account; run 'gh auth login' as $account or 'devenv client on gh'" >&2
            exit 1
        }
    else
        credential=$("$real_gh" auth token --hostname github.com 2>/dev/null) || {
            echo "cred-forward: the local gh is not logged in; run 'gh auth login' or 'devenv client on gh'" >&2
            exit 1
        }
    fi
}

if cred_forward_disabled gh; then
    local_credential
else
    client=$(cred_forward_client)
    status=0
    credential=$("$client" github ${account:+"$account"}) || status=$?
    if [ "$status" != 0 ]; then
        cred_forward_fallback gh "$status"
        local_credential
    fi
fi
printf 'username=%s\n' "${account:-x-access-token}"
printf 'password=%s\n' "$credential"
