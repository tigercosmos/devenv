# Replace the Host and remote socket path for your remote account.
Host my-dev-host
    HostName dev.example.com
    User my-user

    ForwardAgent yes
    RemoteForward /home/my-user/.cache/cred.sock ${HOME}/.cache/cred-agent.sock

# For a macOS remote, use /Users/my-user/.cache/cred.sock instead.
# On the remote, run the administrator command printed by make install.
# It sets StreamLocalBindMask 0177 and StreamLocalBindUnlink yes in sshd_config.
